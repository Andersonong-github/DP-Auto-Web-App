# 复制为 .env 后按需修改（docker compose 会自动读取；Proxmox 请看 deploy/proxmox-oci-lxc.md）
# 全部变量都是可选的，不设置就用镜像内置默认值。

# ---- 服务 ----
DP_APP_NAME=Deltapath Automation
DP_LOG_LEVEL=INFO
# 会话过期（分钟）：空闲超时 + 绝对上限
DP_SESSION_IDLE_MINUTES=60
DP_SESSION_ABSOLUTE_MINUTES=480
# 登录失败节流：窗口内失败 N 次后封锁该来源 IP
DP_LOGIN_MAX_FAILURES=5
DP_LOGIN_WINDOW_SECONDS=300

# ---- PBX 连接 ----
# 登录页的地址预填值，留空则只靠操作员手填
DP_DEFAULT_BASE_URL=
# 1 = 校验 PBX 证书（自签证书场景请保持 0）
DP_TLS_VERIFY=0
DP_REQUEST_TIMEOUT=30

# ---- 反向代理 ----
# 用 HTTPS 反代时设 1（Cookie 只走 HTTPS）
DP_COOKIE_SECURE=0
# 反代后取 X-Forwarded-For 作为客户端 IP（用于登录节流）
DP_TRUST_PROXY_HEADERS=0

# Search & Delete 的删除二次口令（桌面版硬编码为 871211My）
DP_DELETE_PASSWORD=871211My
