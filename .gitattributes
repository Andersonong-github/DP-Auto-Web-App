# Normalise line endings so the repository stays consistent across platforms.
* text=auto eol=lf

# Windows-only scripts keep CRLF so they still run from cmd/PowerShell.
*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Shell scripts must stay LF or they fail to execute on Linux.
*.sh    text eol=lf

# Binary assets — never convert.
*.png   binary
*.ico   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.mp3   binary
*.wav   binary
*.zip   binary
*.gz    binary
*.tar   binary
